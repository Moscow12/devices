# Laravel API Configuration
LARAVEL_API_URL=http://localhost:8000/api
LARAVEL_API_KEY=your-secret-api-key-here
LARAVEL_API_TIMEOUT=30

# Agent Configuration
AGENT_ID=weighbridge-001
AGENT_NAME=Main Weighbridge Agent
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Buffer Configuration
BUFFER_MAX_SIZE=10000
BUFFER_FLUSH_INTERVAL=60
BUFFER_DB_PATH=storage/buffer.db

# Connection Retry
MAX_RETRY_ATTEMPTS=5
RETRY_DELAY=5
